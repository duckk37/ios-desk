{
  "name": "iphone-desk",
  "version": "0.2.0",
  "description": "Personal iPhone mirroring and control client for Windows using WebDriverAgent.",
  "main": "src/main.js",
  "type": "module",
  "author": "Personal use",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "test:ui": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-ui.ps1",
    "pack": "electron-builder --win portable --x64",
    "dist": "npm test && npm run test:ui && electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.iphonedesk.app",
    "productName": "iPhone Desk",
    "asar": true,
    "directories": {
      "output": "release-final"
    },
    "disableAsarIntegrity": true,
    "files": [
      "src/**/*",
      "README.md",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "iPhone-Desk-${version}-Portable.${ext}"
    }
  }
}
